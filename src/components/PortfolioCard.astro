---
interface Props {
  title: string; image: string; material?: string; description?: string; gallery?: string[];
}
const { title, image, material, description, gallery } = Astro.props;
const allImages = [image, ...(gallery ?? [])];
const cardId = title.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
---
<figure class="portfolio-card">
  <div class="img-wrap">
    <img src={image} alt={title} loading="lazy" id={`pf-${cardId}`} />
  </div>
  {allImages.length > 1 && (
    <div class="thumbnails">
      {allImages.map((src, i) => (
        <button
          class:list={['thumb', { active: i === 0 }]}
          data-card={cardId}
          data-src={src}
          aria-label={`View image ${i + 1}`}
        >
          <img src={src} alt="" loading="lazy" />
        </button>
      ))}
    </div>
  )}
  <figcaption>
    <span class="title">{title}</span>
    {material && <span class="material">{material}</span>}
    {description && <p class="desc">{description}</p>}
  </figcaption>
</figure>

<style>
  .portfolio-card { background-color: var(--color-card); border-radius: var(--radius); overflow: hidden; }
  .img-wrap { aspect-ratio: 1; overflow: hidden; background: #333; }
  .img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .portfolio-card:hover .img-wrap img { transform: scale(1.05); }

  .thumbnails {
    display: flex; gap: 0.4rem; padding: 0.5rem 0.75rem;
    background: #1e1e1e; overflow-x: auto; scrollbar-width: none;
  }
  .thumbnails::-webkit-scrollbar { display: none; }
  .thumb {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: 4px;
    overflow: hidden; border: 2px solid transparent; padding: 0;
    cursor: pointer; background: #333; transition: border-color 0.15s;
  }
  .thumb.active { border-color: var(--color-accent); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }

  figcaption { padding: 0.9rem 1rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .title { font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; }
  .material { font-size: 0.8rem; color: var(--color-accent); }
  .desc { font-size: 0.85rem; color: var(--color-text-muted); margin-top: 0.3rem; }
</style>

<script>
  document.querySelectorAll('.portfolio-card .thumbnails').forEach(strip => {
    strip.querySelectorAll<HTMLButtonElement>('.thumb').forEach(btn => {
      btn.addEventListener('click', () => {
        const cardId = btn.dataset.card!;
        const src = btn.dataset.src!;
        const mainImg = document.getElementById(`pf-${cardId}`) as HTMLImageElement;
        if (mainImg) mainImg.src = src;
        strip.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
      });
    });
  });
</script>
